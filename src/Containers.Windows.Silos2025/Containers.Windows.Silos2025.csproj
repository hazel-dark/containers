<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <!--    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>-->
        <RootNamespace>Containers.Windows.Silos</RootNamespace>
        <DefineConstants>$(DefineConstants);WINDOWS_2025</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" Version="71.0.45-preview" PrivateAssets="all" />
        <AdditionalFiles Include="../Containers.Windows.Silos/NativeMethods.txt" />
        <InternalsVisibleTo Include="Containers.Windows.Silos2025.Tests" />
        <!-- Each linked unit is included in the pinned two-build comparison. -->
        <Compile Include="../Containers.Windows.Silos/DescriptionModel/*.cs" Link="Shared/DescriptionModel/%(Filename)%(Extension)" />
        <Compile Include="../Containers.Windows.Silos/I*.cs" Link="Shared/%(Filename)%(Extension)" />
        <Compile Include="../Containers.Windows.Silos/NativeApi.*.cs" Link="Shared/%(Filename)%(Extension)" />
        <Compile Include="../Containers.Windows.Silos/NativeApi.cs" Link="Shared/NativeApi.cs" />
        <Compile Include="../Containers.Windows.Silos/NativeJobConstants.cs" Link="Shared/NativeJobConstants.cs" />
        <Compile Include="../Containers.Windows.Silos/NativeMethods.cs" Link="Shared/NativeMethods.cs" />
        <Compile Include="../Containers.Windows.Silos/NativeProviderConstants.cs" Link="Shared/NativeProviderConstants.cs" />
        <Compile Include="../Containers.Windows.Silos/NativeTypes.cs" Link="Shared/NativeTypes.cs" />
        <Compile Include="../Containers.Windows.Silos/NativeTypes.VReg.cs" Link="Shared/NativeTypes.VReg.cs" />
        <Compile Include="../Containers.Windows.Silos/Pack.cs" Link="Shared/Pack.cs" />
        <Compile Include="../Containers.Windows.Silos/SiloDescriptionXml.cs" Link="Shared/SiloDescriptionXml.cs" />
        <Compile Include="../Containers.Windows.Silos/SiloEventSource.cs" Link="Shared/SileEventSource.cs" />
        <Compile Include="../Containers.Windows.Silos/SiloException.cs" Link="Shared/SiloException.cs" />
        <Compile Include="../Containers.Windows.Silos/SiloTerminationNotification.cs" Link="Shared/SiloTerminationNotification.cs" />
        <Compile Include="../Containers.Windows.Silos/WindowsSilo.cs" Link="Shared/WindowsSilo.cs" />
    </ItemGroup>
</Project>
